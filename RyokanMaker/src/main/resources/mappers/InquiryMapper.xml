<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mnu.ryokanmaker.mapper.InquiryMapper">

    <resultMap id="inquiryResultMap" type="com.mnu.ryokanmaker.dto.InquiryDto">
        <id     column="INQUIRY_IDX"            property="inquiryIdx"/>
        <result column="ADMIN_IDX"              property="adminIdx"/>
        <result column="USER_MAIL"              property="userMail"/>
        <result column="INQUIRY_TITLE"          property="inquiryTitle"/>
        <result column="INQUIRY_CONTENT"        property="inquiryContent"/>
        <result column="INQUIRY_ANSWER_CONTENT" property="inquiryAnswerContent"/>
        <result column="INQUIRY_STATUS"         property="inquiryStatus"/>
        <result column="INQUIRY_CREATED_AT"     property="inquiryCreatedAt"/>
    </resultMap>

    <select id="selectListByUserMail" parameterType="string" resultMap="inquiryResultMap">
        SELECT * FROM INQUIRY
        WHERE USER_MAIL = #{userMail}
        ORDER BY INQUIRY_IDX DESC
    </select>

    <select id="selectByIdx" parameterType="int" resultMap="inquiryResultMap">
        SELECT * FROM INQUIRY WHERE INQUIRY_IDX = #{inquiryIdx}
    </select>

    <insert id="insert" parameterType="com.mnu.ryokanmaker.dto.InquiryDto"
            useGeneratedKeys="true" keyProperty="inquiryIdx" keyColumn="INQUIRY_IDX">
        INSERT INTO INQUIRY (ADMIN_IDX, USER_MAIL, INQUIRY_TITLE, INQUIRY_CONTENT, INQUIRY_STATUS, INQUIRY_CREATED_AT)
        VALUES (#{adminIdx}, #{userMail}, #{inquiryTitle}, #{inquiryContent}, '답변대기', SYSTIMESTAMP)
    </insert>

    <delete id="deleteByIdx" parameterType="int">
        DELETE FROM INQUIRY WHERE INQUIRY_IDX = #{inquiryIdx}
    </delete>

    <delete id="deleteByUserMail" parameterType="string">
        DELETE FROM INQUIRY WHERE USER_MAIL = #{userMail}
    </delete>

</mapper>
