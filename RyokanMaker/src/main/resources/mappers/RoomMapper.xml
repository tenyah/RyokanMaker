<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mnu.ryokanmaker.mappers.RoomMapper">
<select id="findAll" resultType="com.mnu.ryokanmaker.domain.RoomDTO">
    SELECT "RoomIdx", "AdminIdx", "RoomName", "RoomLevel", "RoomInfo",
           "RoomPrice", "RoomPeople", "RoomImage", "RoomMemo", "RoomSaleYN"
    FROM "ROOM"
    WHERE "RoomSaleYN" = 'Y'
    ORDER BY "RoomIdx"
</select>
</mapper>