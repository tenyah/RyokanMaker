<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mnu.ryokanmaker.mappers.CourseMapper">
<select id="findAll" resultType="com.mnu.ryokanmaker.domain.CourseDTO">
    SELECT "RestaurantCourseIdx", "RestaurantCourseName", "RestaurantCourseImage",
           "RestaurantCourseInfo", "AdminIdx", "RestaurantCourseSaleYN"
    FROM "RESTAURANT_COURSE"
    WHERE "RestaurantCourseSaleYN" = 'Y'
    ORDER BY "RestaurantCourseIdx"
</select>
</mapper>