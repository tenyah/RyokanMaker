<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mnu.ryokanmaker.mapper.NoticeMapper">

    <resultMap id="noticeResultMap" type="com.mnu.ryokanmaker.dto.NoticeDto">
        <id     column="NOTICE_IDX"        property="noticeIdx"/>
        <result column="ADMIN_IDX"         property="adminIdx"/>
        <result column="NOTICE_TITLE"      property="noticeTitle"/>
        <result column="NOTICE_CONTENT"    property="noticeContent"/>
        <result column="NOTICE_CREATED_AT" property="noticeCreatedAt"/>
    </resultMap>

    <select id="selectList" resultMap="noticeResultMap">
        SELECT * FROM NOTICE
        ORDER BY NOTICE_IDX DESC
    </select>

    <select id="selectByIdx" parameterType="int" resultMap="noticeResultMap">
        SELECT * FROM NOTICE WHERE NOTICE_IDX = #{noticeIdx}
    </select>

</mapper>
